; Engine configuration file.
; Turbo Tots Kart - Godot 4.3 (Compatibility renderer)

config_version=5

[application]

config/name="Turbo Tots Kart"
config/description="A low-poly kart racer with drift boosts, power-ups, Grand Prix and ghost time trials."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.12, 0.07, 0.3, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
